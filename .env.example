# LifeSync - environment variables (desenvolvimento local)
# Copie este arquivo para .env e preencha com os valores reais.
# O .env e lido pelo docker compose e injetado nos containers. Ele esta no
# .gitignore -- nunca comite credenciais.

# === Google OAuth (https://console.cloud.google.com/apis/credentials) ===
# 1. Crie um OAuth 2.0 Client ID do tipo "Web application".
# 2. Em "Authorized redirect URIs", cadastre EXATAMENTE as duas URLs abaixo:
#      http://localhost:6006/auth/google-callback      (local)
#      https://api.lifesync.tech/auth/google-callback  (producao)
#    O Google rejeita IPs de rede privada (10.0.2.2, 192.168.x.x), por isso o
#    fluxo local usa localhost + "adb reverse tcp:6006 tcp:6006" no Android.
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME

# Precisa ser identico na URL de consentimento e na troca do code por token,
# senao o Google responde redirect_uri_mismatch.
GOOGLE_REDIRECT_URI=http://localhost:6006/auth/google-callback

# Custom scheme para o qual a API redireciona apos o callback (deve bater com o
# IntentFilter do Android e o CFBundleURLSchemes do iOS no app MAUI).
GOOGLE_APP_SCHEME=com.lifesync.app
