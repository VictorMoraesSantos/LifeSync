{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Users.Infrastructure.Services.GoogleAuthService": "Information"
    }
  },
  "RabbitMQSettings": {
    "Host": "localhost",
    "User": "guest",
    "Password": "guest",
    "Port": 5672
  },
  "GoogleAuth": {
    // Sobrescreve o RedirectUri de producao (appsettings.json) no ambiente local.
    // O Google so aceita localhost/127.0.0.1 ou dominio publico -- IPs de rede
    // privada (10.0.2.2, 192.168.x.x) sao rejeitados. Por isso o app Android
    // precisa de "adb reverse tcp:6006 tcp:6006" para alcancar este endereco.
    // Cadastre exatamente esta URL em Authorized redirect URIs no Google Console.
    "RedirectUri": "http://localhost:6006/auth/google-callback",
    "AppScheme": "com.lifesync.app"
  }
}
