# === Domains ===
API_DOMAIN=api.seudominio.com
APP_DOMAIN=app.seudominio.com
ACME_EMAIL=seu@email.com

# === Database ===
DB_USER=lifesync
DB_PASSWORD=CHANGE_ME

# === RabbitMQ ===
RABBIT_USER=lifesync
RABBIT_PASSWORD=CHANGE_ME

# === Google OAuth (https://console.cloud.google.com/apis/credentials) ===
# Cadastre https://${API_DOMAIN}/auth/google-callback em "Authorized redirect URIs".
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
# Opcional: por padrao usa https://${API_DOMAIN}/auth/google-callback
# GOOGLE_REDIRECT_URI=https://api.seudominio.com/auth/google-callback
# GOOGLE_APP_SCHEME=com.lifesync.app

# === SMTP ===
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=no-reply@seudominio.com

# === Image Tags (updated by CI/CD) ===
TASKMANAGER_TAG=main-0000000
NUTRITION_TAG=main-0000000
FINANCIAL_TAG=main-0000000
USERS_TAG=main-0000000
GYM_TAG=main-0000000
NOTIFICATION_TAG=main-0000000
